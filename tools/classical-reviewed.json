      "者",
      "……的人；判断句停顿",
      [
        {
          "text": "师者，所以传道受业解惑也。",
          "source": "韩愈《师说》",
          "note": "者：在判断句主语后表停顿。"
        },
        {
          "text": "假舆马者，非利足也，而致千里。",
          "source": "荀子《劝学》",
          "note": "者：与前面的动词短语组成“……的人”。"
        }
      ]
    ],
    [
      "虚词",
      "焉",
      "于此；句末语气",
      [
        {
          "text": "积土成山，风雨兴焉。",
          "source": "荀子《劝学》",
          "note": "焉：于此，即从这里。"
        },
        {
          "text": "于其身也，则耻师焉。",
          "source": "韩愈《师说》",
          "note": "焉：句末语气词，不译为“在哪里”。"
