{
  "junior": [
    [
      "实词",
      "安",
      "怎么；安稳",
      [
        {
          "text": "安能辨我是雄雌？",
          "source": "《木兰诗》",
          "note": "安：怎么，表示反问。"
        },
        {
          "text": "风雨不动安如山。",
          "source": "杜甫《茅屋为秋风所破歌》",
          "note": "安：安稳，形容房屋稳固。"
        }
      ]
    ],
    [
      "实词",
      "兵",
      "兵器；军队",
      [
        {
          "text": "兵革非不坚利也。",
          "source": "《孟子·公孙丑下》（《得道多助，失道寡助》）",
          "note": "兵：兵器，与“革”并列。"
        },
        {
          "text": "上使外将兵。",
          "source": "司马迁《陈涉世家》",
          "note": "兵：军队；将兵即率领军队。"
        }
      ]
    ],
    [
      "实词",
      "负",
      "背着；依仗",
      [
        {
          "text": "负者歌于途。",
          "source": "欧阳修《醉翁亭记》",
          "note": "负：背着东西；负者指背东西的人。"
        },
        {
          "text": "负势竞上，互相轩邈。",
          "source": "吴均《与朱元思书》",
          "note": "负：凭借、依仗；此处描写山势。"
        }
      ]
    ],
    [
      "实词",
      "故",
      "原因；旧的",
      [
        {
          "text": "既克，公问其故。",
          "source": "《左传·曹刿论战》",
          "note": "故：原因，指取胜的原因。"
        },
        {
          "text": "温故而知新，可以为师矣。",
          "source": "《论语·为政》",
          "note": "故：旧的知识；此处作名词。"
        }
      ]
    ],
    [
      "实词",
      "见",
      "拜见；了解",
      [
        {
          "text": "公将战，曹刿请见。",
          "source": "《左传·曹刿论战》",
          "note": "见：拜见，不能机械译成“看见”。"
        },
        {
          "text": "但当涉猎，见往事耳。",
          "source": "司马光《资治通鉴》（《孙权劝学》）",
          "note": "见：了解；往事指历史。"
        }
      ]
    ],
    [
      "实词",
      "期",
      "约定；期限",
      [
        {
          "text": "陈太丘与友期行。",
          "source": "《世说新语·方正》（《陈太丘与友期行》）",
          "note": "期：约定。"
        },
        {
          "text": "失期，法皆斩。",
          "source": "司马迁《陈涉世家》",
          "note": "期：规定的期限；失期即误期。"
        }
      ]
    ],
    [
      "实词",
      "去",
      "离开；距离",
      [
        {
          "text": "停数日，辞去。",
          "source": "陶渊明《桃花源记》",
          "note": "去：离开；辞去即告辞离开。"
        },
        {
          "text": "我以日始出时去人近。",
          "source": "《列子·汤问》（《两小儿辩日》）",
          "note": "去：距离。"
        }
      ]
    ],
    [
      "实词",
      "素",
      "平素；不加装饰的",
      [
        {
          "text": "吴广素爱人。",
          "source": "司马迁《陈涉世家》",
          "note": "素：一向、平素。"
        },
        {
          "text": "可以调素琴，阅金经。",
          "source": "刘禹锡《陋室铭》",
          "note": "素：不加装饰的；素琴指不加装饰的琴。"
        }
      ]
    ],
    [
      "虚词",
      "之",
      "代词；用于主谓之间",
      [
        {
          "text": "学而时习之，不亦说乎？",
          "source": "《论语·学而》",
          "note": "之：代词，指所学的内容。"
        },
        {
          "text": "予独爱莲之出淤泥而不染。",
          "source": "周敦颐《爱莲说》",
          "note": "之：用于主语“莲”和谓语之间，不单独译出。"
        }
      ]
    ],
    [
      "虚词",
      "其",
      "代词；表示推测",
      [
        {
          "text": "屠大窘，恐前后受其敌。",
          "source": "蒲松龄《狼》",
          "note": "其：代词，指狼。"
        },
        {
          "text": "其真不知马也！",
          "source": "韩愈《马说》",
          "note": "其：表示推测，可译为“恐怕”。与前句的反问语气不同。"
        }
      ]
    ],
    [
      "虚词",
      "而",
      "表转折；表承接",
      [
        {
          "text": "人不知而不愠，不亦君子乎？",
          "source": "《论语·学而》",
          "note": "而：表转折，可译为“却”。"
        },
        {
          "text": "温故而知新，可以为师矣。",
          "source": "《论语·为政》",
          "note": "而：连接温习旧知与获得新理解，表示承接。"
        }
      ]
    ],
    [
      "虚词",
      "以",
      "用；因为",
      [
        {
          "text": "屠惧，投以骨。",
          "source": "蒲松龄《狼》",
          "note": "以：用；投以骨即把骨头投给狼。"
        },
        {
          "text": "不以物喜，不以己悲。",
          "source": "范仲淹《岳阳楼记》",
          "note": "以：因为；不是“用”的意思。"
        }
      ]
    ],
    [
      "虚词",
      "于",
      "在；比",
      [
        {
          "text": "公与之乘，战于长勺。",
          "source": "《左传·曹刿论战》",
          "note": "于：在，引出作战地点。"
        },
        {
          "text": "皆以美于徐公。",
          "source": "《战国策·邹忌讽齐王纳谏》",
          "note": "于：比，引出比较对象。"
        }
      ]
    ],
    [
      "虚词",
      "为",
      "做、成为；被（须结合语境判断词性）",
      [
        {
          "text": "可以为师矣。",
          "source": "《论语·为政》",
          "note": "为：做、成为，此处是动词。总表按多用法词归类，不表示每句都是虚词。"
        },
        {
          "text": "山峦为晴雪所洗。",
          "source": "袁宏道《满井游记》",
          "note": "为：与“所”呼应，表示被动。"
        }
      ]
    ],
    [
      "虚词",
      "盖",
      "原来；大概",
      [
        {
          "text": "乃悟前狼假寐，盖以诱敌。",
          "source": "蒲松龄《狼》",
          "note": "盖：原来是，解释前狼假睡的原因。"
        },
        {
          "text": "盖余之勤且艰若此。",
          "source": "宋濂《送东阳马生序》",
          "note": "盖：句首发语词，引出说明，不宜套用“覆盖”的实词义。"
        }
      ]
    ],
    [
      "虚词",
      "乃",
      "于是；才",
      [
        {
          "text": "屠乃奔倚其下，弛担持刀。",
          "source": "蒲松龄《狼》",
          "note": "乃：于是，表示动作承接。"
        },
        {
          "text": "乃悟前狼假寐，盖以诱敌。",
          "source": "蒲松龄《狼》",
          "note": "乃：才，表示此时方才明白。"
        }
      ]
    ]
  ],
  "senior": [
    [
      "实词",
      "爱",
      "爱护；吝惜",
      [
        {
